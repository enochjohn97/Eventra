[TEMPLATE]
# =========================
# COPY THIS FILE TO .env AND FILL IN YOUR OWN VALUES.
# Never commit a .env file that contains real credentials.
# =========================

# =========================
# APPLICATION
# =========================
APP_NAME=EventOut
APP_ENV=auto
APP_DEBUG=true
APP_URL=http://localhost:8000/
# Live platform origin — used for share links / QR codes so they never point at localhost
PRODUCTION_APP_URL=https://your-production-domain.example

# =========================
# DATABASE (LIVE)
# =========================
LIVE_DB_CONNECTION=mysql
LIVE_DB_HOST=your-live-db-host.example
LIVE_DB_PORT=3306
LIVE_DB_DATABASE=your_live_database
LIVE_DB_USERNAME=your_live_db_user
LIVE_DB_PASSWORD=your_live_db_password

# =========================
# DATABASE (LOCAL)
# =========================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=eventra_db
DB_USERNAME=root
DB_PASSWORD=

# =========================
# GOOGLE OAUTH
# =========================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google-signin.php

# =========================
# GOOGLE MAPS
# =========================
GOOGLE_MAPS_API_KEY='your-google-maps-api-key'

# =========================
# GOOGLE CALENDAR
# =========================
GOOGLE_CALENDAR_API_KEY='your-google-calendar-api-key'
GOOGLE_WEBHOOK_SECRET='your-google-webhook-secret'
# Holiday/festive toast alerts (admin dashboard, client dashboard, homepage).
# Comma-separated Google Calendar IDs - defaults to both Nigerian holiday calendars.
GOOGLE_HOLIDAY_CALENDAR_IDS='en.ng#holiday@group.v.calendar.google.com,en.ng.official#holiday@group.v.calendar.google.com'

# =========================
# MAIL (Optional)
# =========================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username@example.com
MAIL_PASSWORD=your-smtp-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your-smtp-username@example.com
MAIL_FROM_NAME=Eventra

# =========================
# FILE UPLOADS
# =========================
UPLOAD_MAX_SIZE=15M
UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,webp,avif

# =========================
# SECURITY
# =========================
CSRF_TOKEN_EXPIRY=3600
SESSION_LIFETIME=7200

# =========================
# PAYMENTS (PAYSTACK)
# =========================
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PLATFORM_BUSINESS_NAME=Your Platform Business Name
# Settlement account that receives the platform commission. Required: the
# Attoneex/platform subaccount is created automatically under each client's
# Paystack account from these two values, then cached per integration.
PAYSTACK_PLATFORM_SUBACCOUNT_BANK_CODE=057
PAYSTACK_PLATFORM_SETTLEMENT_ACCOUNT_NUMBER=your_10_digit_account_number
PAYSTACK_PLATFORM_SETTLEMENT_ACCOUNT_NAME=YOUR COMPANY LIMITED

# =========================
# MOBILE APP STORE LINKS
# Shown when a "Get for someone else" recipient has no account yet.
# =========================
PLAY_STORE_URL=https://play.google.com/store/apps/details?id=your.android.package
APP_STORE_URL=https://apps.apple.com/app/your-app/id000000000

# =========================
# BREVO
# =========================
BREVO_API_KEY=your-brevo-api-key

# =========================
# CRON
# =========================
CRON_SECRET=your_cron_secret

# =========================
# QR CODE
# =========================
QR_SECRET=your_qr_secret
